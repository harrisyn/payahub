# Production variables for docker-compose.prod.yml. In Dokploy paste these into
# the app's Environment tab; Dokploy writes them to .env beside the compose file.
# Never commit a filled-in copy.

# Public hostnames (no scheme). Point an A record for each at the Dokploy server.
# WEB_DOMAIN: landing page and docs. APP_DOMAIN: sign-in and the console, with the
# operators' super admin at /console/operator. API_DOMAIN: the REST API.
WEB_DOMAIN=payahub.com
APP_DOMAIN=app.payahub.com
API_DOMAIN=api.payahub.com

# Required secrets.
# openssl rand -hex 24  (hex, so it is safe inside the database URL)
POSTGRES_PASSWORD=
# openssl rand -base64 32. Seals insurer credentials and model keys. Keep a copy
# outside the server: losing it means every organisation re-enters its credentials.
PAYAHUB_VAULT_KEY=

# Optional: an external Postgres (for example a Dokploy-managed database)
# instead of the bundled one. Unset, the bundled postgres service is used.
# DATABASE_URL=postgres://user:password@host:5432/payahub?sslmode=require

# Email (invitations, enquiries). Unset, email is only logged.
PAYAHUB_SMTP_URL=
PAYAHUB_MAIL_FROM=no-reply@payahub.com

# Payments. Paystack funds and withdraws wallets; the sandbox provider is for staging only.
PAYAHUB_PAYSTACK_SECRET_KEY=
PAYAHUB_PAYMENTS_SANDBOX=

# Capacity: concurrent submissions per worker, and how many worker containers.
PAYAHUB_WORKERS=100
PAYAHUB_WORKER_REPLICAS=1
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=512MB

# Web app.
NEXT_PUBLIC_CONTACT_EMAIL=hello@payahub.com
# 1 lets search engines index the site (leave empty until launch).
NEXT_PUBLIC_SITE_INDEXABLE=

# Tag for the built images, for example the git commit; rolls back by redeploying an older one.
PAYAHUB_RELEASE=latest
